{
    "name": "root",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "clean": "turbo run clean",
        "dev": "turbo run dev",
        "dev:docs": "turbo run dev --filter=docs",
        "lint": "turbo run lint",
        "lint:format": "oxfmt --check",
        "format:md": "markdownlint-cli2 --fix 'apps/docs/content/**/*.md'",
        "format": "oxfmt && format:md",
        "release": "turbo run build --filter=./packages/* && changeset publish && pnpm -r run postpublish",
        "test": "vitest",
        "types:check": "turbo run types:check --continue",
        "dep:check": "bunx npm-check-updates --workspaces --root",
        "dep:upgrade": "bunx npm-check-updates --workspaces --root --upgrade",
        "version": "changeset version && pnpm install --lockfile-only"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "bun": "1.3.13",
        "concurrently": "^9.2.1",
        "markdownlint-cli2": "^0.22.1",
        "oxfmt": "^0.48.0",
        "oxlint": "^1.61.0",
        "rimraf": "^6.1.3",
        "turbo": "^2.9.6",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    },
    "engines": {
        "bun": ">= 1.3.13",
        "node": ">= 18.17.0"
    },
    "packageManager": "bun@1.3.13"
}
