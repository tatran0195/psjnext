{
    "$schema": "https://v2-9-6.turborepo.dev/schema.json",
    "globalEnv": [
        "NEXT_PUBLIC_ORAMA_DATASOURCE_ID",
        "NEXT_PUBLIC_ORAMA_PROJECT_ID",
        "NEXT_PUBLIC_ORAMA_API_KEY",
        "ORAMA_PRIVATE_API_KEY",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_ID",
        "GITHUB_TOKEN",
        "INKEEP_API_KEY"
    ],
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [
                ".output",
                "public/registry",
                ".source/**",
                ".next/**",
                "!.next/cache/**",
                "dist/**",
                "css/generated/**",
                "out",
                "build",
                ".vercel",
                "jupiterutils/**",
                "IDEData/**",
                "IDEData.zip",
                "output/**"
            ]
        },
        "lint": {},
        "types:check": {
            "dependsOn": [],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": [],
            "outputs": []
        },
        "generate": {
            "dependsOn": ["build"],
            "cache": false
        },
        "clean": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
