{
    "name": "jupiterutils",
    "version": "1.0.0",
    "description": "Jupiter Utilities",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "start": "bun run src/index.ts",
        "dev": "bun --watch run src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun --minify",
        "typecheck": "tsc --noEmit",
        "lint": "bunx oxlint",
        "format": "bunx oxlint --fix"
    },
    "dependencies": {
        "fflate": "^0.8.2"
    },
    "devDependencies": {
        "bun-types": "^1.3.13",
        "typescript": "^5.9.3"
    },
    "engines": {
        "bun": ">=1.3.13"
    }
}
