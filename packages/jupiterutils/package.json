{
    "name": "psj-editor",
    "version": "2.0.0",
    "description": "PSJ documentation & Python code generator",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "bun run src/index.ts",
        "generate": "bun run build && node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "bunx oxlint",
        "format": "bunx oxlint --fix"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "dotenv": "^17.4.2",
        "fast-glob": "^3.3.3"
    },
    "devDependencies": {
        "@types/archiver": "^7.0.0",
        "@types/node": "^25.6.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
