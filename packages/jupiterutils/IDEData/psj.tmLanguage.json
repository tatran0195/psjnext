{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "psj",
    "patterns": [
        {
            "include": "#classes"
        },
        {
            "include": "#methods"
        }
    ],
    "repository": {
        "classes": {
            "patterns": [
                {
                    "match": "\\b()\\b",
                    "name": "support.class.psj"
                }
            ]
        },
        "methods": {
            "patterns": [
                {
                    "match": "\\b()\\b",
                    "name": "support.function.psj"
                }
            ]
        }
    },
    "scopeName": "source.psj"
}