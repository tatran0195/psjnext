{
    "name": "jcall",
    "version": "0.1.0",
    "description": "Generate MDX docs for your JCALL v2 SDK spec",
    "keywords": [
        "Docs",
        "JCALL",
        "NextJs"
    ],
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./ui": "./dist/ui/index.js",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown --config-loader unrun",
        "clean": "rimraf dist",
        "dev": "tsdown --watch --clean false",
        "lint": "oxlint .",
        "test": "vitest run",
        "types:check": "tsc --noEmit"
    },
    "dependencies": {
        "chokidar": "^5.0.0",
        "js-yaml": "^4.1.1",
        "shiki": "^4.0.2"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "25.6.0",
        "@types/react": "^19.2.14",
        "fumadocs-core": "16.7.10",
        "fumadocs-ui": "16.7.10",
        "tsconfig": "workspace:*",
        "tsdown": "0.21.9"
    },
    "peerDependencies": {
        "@types/react": "*",
        "fumadocs-core": "^16.7.15",
        "fumadocs-ui": "^16.7.15",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        }
    }
}
