{
    "name": "psjapi",
    "version": "1.0.0",
    "description": "TechnoStar Jupiter CAE Desktop Platform SDK docs",
    "keywords": [
        "CAE",
        "Docs",
        "Jupiter",
        "NextJs",
        "PSJ",
        "TechnoStar"
    ],
    "homepage": "https://www.e-technostar.com/",
    "license": "MIT",
    "files": [
        "css",
        "dist",
        "scripts"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./i18n": "./dist/i18n.js",
        "./server": "./dist/server/index.js",
        "./ui": "./dist/ui/index.js",
        "./package.json": "./package.json",
        "./css/*": "./css/*"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "build:css": "tsx scripts/compile-inline.ts",
        "clean": "rimraf dist css/generated",
        "dev": "tsdown --watch --clean false",
        "lint": "oxlint .",
        "test": "vitest run",
        "types:check": "tsc --noEmit"
    },
    "dependencies": {
        "chokidar": "^5.0.0",
        "clsx": "^2.1.1",
        "github-slugger": "^2.0.0",
        "hast-util-to-jsx-runtime": "^2.3.6",
        "remark": "^15.0.1",
        "remark-gfm": "^4.0.1",
        "remark-rehype": "^11.1.2",
        "tailwind-merge": "^3.5.0",
        "unified": "^11.0.5",
        "vfile": "^6.0.3",
        "yaml": "^2.8.3"
    },
    "devDependencies": {
        "@fumadocs/tailwind": "0.0.5",
        "@types/hast": "^3.0.4",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "fumadocs-core": "^16.8.3",
        "fumadocs-ui": "^16.8.3",
        "oxlint": "^1.61.0",
        "react": "^19.2.5",
        "rimraf": "^6.1.3",
        "shiki": "^4.0.2",
        "tsconfig": "workspace:*",
        "tsdown": "^0.21.10",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    },
    "peerDependencies": {
        "@types/react": "*",
        "fumadocs-core": "^16.7.15",
        "fumadocs-ui": "^16.7.15",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "shiki": "^4.0.2"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        },
        "shiki": {
            "optional": true
        }
    }
}
