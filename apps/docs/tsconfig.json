{
    "extends": "tsconfig/nextjs.json",
    "compilerOptions": {
        "types": ["bun-types"],
        "paths": {
            "@/*": ["./*"],
            "collections/*": ["./.source/*"]
        }
    },
    "include": ["next-env.d.ts", "**/*.ts", "content/**/*.mdx", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules", "eslint.config.mjs", "components/registry/build-graph.ts"]
}
