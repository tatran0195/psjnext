{
    "name": "psjex",
    "displayName": "psjex",
    "version": "0.0.1",
    "description": "VS Code extension for PSJ API Documentation management.",
    "categories": [
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/psj-docs/psjdocs-2.git"
    },
    "publisher": "psj",
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.100.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "esbuild": "^0.27.3",
        "eslint": "^9.39.3",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vsce": "^2.15.0"
    },
    "contributes": {
        "commands": [
            {
                "command": "psjex.bumpDocs",
                "title": "PSJ: Bump API Docs Submodule"
            },
            {
                "command": "psjex.initSubmodule",
                "title": "PSJ: Init API Submodule"
            },
            {
                "command": "psjex.syncSubmodule",
                "title": "PSJ: Sync API Submodule"
            },
            {
                "command": "psjex.initAllSubmodules",
                "title": "PSJ: Init All Submodules"
            },
            {
                "command": "psjex.syncAllSubmodules",
                "title": "PSJ: Sync All Submodules"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "psjex.bumpDocs",
                    "when": "resourceScheme == 'file' && resourceFilename =~ /^[0-9]+\\.[0-9]+\\.[0-9]+$/",
                    "group": "1_psj@1"
                },
                {
                    "command": "psjex.initSubmodule",
                    "when": "resourceScheme == 'file' && resourceFilename =~ /^[0-9]+\\.[0-9]+\\.[0-9]+$/",
                    "group": "1_psj@2"
                },
                {
                    "command": "psjex.syncSubmodule",
                    "when": "resourceScheme == 'file' && resourceFilename =~ /^[0-9]+\\.[0-9]+\\.[0-9]+$/",
                    "group": "1_psj@3"
                },
                {
                    "command": "psjex.initAllSubmodules",
                    "when": "resourceScheme == 'file' && resourceFilename == 'api'",
                    "group": "1_psj@4"
                },
                {
                    "command": "psjex.syncAllSubmodules",
                    "when": "resourceScheme == 'file' && resourceFilename == 'api'",
                    "group": "1_psj@5"
                }
            ]
        }
    },
    "activationEvents": [],
    "engines": {
        "vscode": "^1.100.0"
    }
}
